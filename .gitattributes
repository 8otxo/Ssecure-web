# Los scripts que se ejecutan DENTRO de los contenedores (Linux) y el lanzador
# de bash deben tener finales de línea LF siempre. Si Git en Windows los
# convierte a CRLF, el contenedor falla con un error críptico:
#     exec /sniff.sh: no such file or directory
# Esta línea evita ese clásico de clase.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.conf          text eol=lf
Makefile        text eol=lf
*.txt           text eol=lf

# El lanzador de Windows sí lleva CRLF.
*.ps1           text eol=crlf
