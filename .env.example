# PostgreSQL
POSTGRES_USER=securelab
POSTGRES_PASSWORD=securelab_dev_only
POSTGRES_DB=securelab

# Backend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=insecure-dev-key-change-in-production
DATABASE_URL=postgresql://securelab:securelab_dev_only@db:5432/securelab

# Puertos host — valores de la FASE 3 (la web, sin atacantes)
FRONTEND_PORT=8080
BACKEND_PORT=8000

# FASE 4 (atacantes): `make fase4-ataque` los intercambia automáticamente,
#   FRONTEND_PORT=8081  (nginx directo, para comparar)
#   MITM_HOST_PORT=8080 (el atacante se queda la URL que ya usaba el alumno)
# No hace falta tocarlos a mano; solo si quieres fijar otro reparto.
MITM_HOST_PORT=8081

# Sniffer pasivo (Demo A). Valores por defecto en sniffer/sniff.sh;
# descomenta para ajustar la interfaz o el filtro BPF de captura.
# SNIFF_IFACE=any
# SNIFF_FILTER=tcp port 8000
